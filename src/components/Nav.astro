  <a href="/" class="font-sora">Jakob Winklehner</a>
  <div class="flex flex-wrap justify-center gap-4">
    <a href="/projects" class={`link ${currentPath === "/projects" || currentPath === "/technology" ? "!text-foreground" : ""}`}>projects</a>
    <a href="/workedu" class={`link ${currentPath === "/workedu" || currentPath === "/technology" ? "!text-foreground" : ""}`}>education & work</a>
